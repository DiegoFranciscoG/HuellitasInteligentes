# Reemplaza con la IP de tu PC para probar en dispositivo físico
# Ejemplo: API_URL=http://192.168.1.10:8087/api
# Producción: API_URL=http://159.89.237.245:8087/api
API_URL=http://localhost:8087/api

# Opcional: servidor TURN para WebRTC (cámaras) detrás de NATs estrictos.
# Sin esto, WebRTC solo usa STUN público de Google (funciona en la mayoría
# de redes domésticas, puede fallar en redes corporativas/algunos operadores).
# Usamos el plan gratuito de Metered (https://www.metered.ca/tools/openrelay/):
# las credenciales TURN se piden en tiempo real con esta API key, así nunca
# quedan desactualizadas si rotan en el panel de Metered.
# TURN_METERED_DOMAIN=tu-subdominio.metered.live
# TURN_METERED_API_KEY=tu-api-key
