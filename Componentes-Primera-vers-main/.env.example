# Variables de entorno del backend de Huellitas Inteligentes.
#
# Ninguna credencial se guarda en el repositorio. Copia este archivo, ponle los
# valores reales y cargalos en el entorno antes de arrancar la aplicacion.
#
#   Windows (una sola vez, por usuario):   setx NOMBRE "valor"
#   Linux / macOS:                         export NOMBRE="valor"
#   Docker:                                docker run --env-file .env ...

# ── Base de datos (PostgreSQL / Neon) ──────────────────────────────────────
DB_PASSWORD=

# ── Correo transaccional (Brevo) ───────────────────────────────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Huellitas App

# ── Almacenamiento de archivos (Backblaze B2, compatible con S3) ───────────
B2_MEDIA_ACCESS_KEY=
B2_MEDIA_SECRET_KEY=
B2_AVATAR_ACCESS_KEY=
B2_AVATAR_SECRET_KEY=

# ── Inicio de sesion social ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── Pagos (Stripe) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# ── Inteligencia artificial ────────────────────────────────────────────────
OPENROUTER_API_KEY_IA=
OPENROUTER_API_KEY_MOD=
GOOGLE_PLACES_API_KEY=

# ── Autenticacion (JWT) ─────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
GOOGLE_REDIRECT_URI=http://localhost:8087/api/huellitas/auth/google/callback
FACEBOOK_REDIRECT_URI=http://localhost:8087/api/huellitas/auth/facebook/callback

# ── Inteligencia artificial (adicionales) ──────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY_MODERACION=

# ── Moderacion de contenido (Sightengine) ──────────────────────────────────
# Opcional: si se deja vacio, SightengineService queda inactivo (no bloquea nada).
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# ── Otros ──────────────────────────────────────────────────────────────────
RESEND_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4000
APP_WEB_URL=http://localhost:4200
SERVER_PORT=8087
